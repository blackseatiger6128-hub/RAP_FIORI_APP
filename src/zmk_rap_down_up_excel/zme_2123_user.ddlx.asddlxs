@Metadata.layer:  #CORE
@UI.headerInfo: {
  typeName: 'User',
  typeNamePlural: 'Users',
  title: {
    type: #STANDARD,
    value: 'Emp_Id' },
    description: { value: 'Dev_Id' }
}
annotate entity ZC_2123_USER with
{
  @UI.facet: [
      {
       purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         position: 10,
         targetQualifier: 'description'
      },
      {
       purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         position: 20,
         targetQualifier: 'fileStatus'
      },
      {
       purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         position: 25,
         targetQualifier: 'templateStatus'
      },
      {
       purpose: #HEADER,
         type: #DATAPOINT_REFERENCE,
         position: 30,
         targetQualifier: 'fileChanged'
      },
      {
       //this is collection facet
       purpose: #STANDARD,
         type: #COLLECTION,
         label: 'General Info',
         position: 10,
         id: 'idUserCollection'
      },
      /* Child Facet 1: User Info (Identification) */
      {
       purpose: #STANDARD,
         type: #IDENTIFICATION_REFERENCE,
         label: 'User Info',
         position: 10,
         id: 'idUserInfo',
         parentId: 'idUserCollection'
      },
      /* Child Facet 2: Log Details (Fieldgroup) */
      {
       purpose: #STANDARD,
         type: #FIELDGROUP_REFERENCE,
         label: 'Log Details',
         position: 20,
         id: 'idLogsGroup',
         parentId: 'idUserCollection',
         targetQualifier: 'logs'
      },
      /* Line Item Facet */
      {
       purpose: #STANDARD,
         type: #LINEITEM_REFERENCE,
         label: 'Developed Objects',
         position: 20,
         id: 'idDevObj',
         targetElement: '_UserDev'
      }
    ]

  @EndUserText.label: 'User Id'
  @UI:{
    lineItem: [
      { position: 10, importance: #HIGH, label: 'User Id' },
      { type: #FOR_ACTION, dataAction: 'uploadExcelData', label: 'Upload Data', position: 10 },
      { type: #FOR_ACTION, dataAction: 'DownloadExcel', label: 'Download Data', position: 20 }
    ],
    identification: [
      { position: 10, label: 'User Id' },
      { type: #FOR_ACTION, dataAction: 'uploadExcelData', label: 'Upload Data', position: 10 },
      { type: #FOR_ACTION, dataAction: 'DownloadExcel', label: 'Download Data', position: 20 }
    ],
    selectionField: [{ position: 10 }]
  }
  Emp_Id;

  @EndUserText.label: 'Development Id'
  @UI:{ lineItem: [{ position: 20, importance: #HIGH, label: 'Development Id' }],
        selectionField: [{ position: 20 }],
        identification: [{ position: 20, label: 'Development Id' }]
  }
  Dev_Id;

  @EndUserText.label: 'Development Description'
  @UI:{ lineItem: [{ position: 30, importance: #HIGH, label: 'Development Description' }],
        dataPoint: { qualifier: 'description', title: 'Development Description' },
        identification: [{ position: 30, label: 'Development Description' }]
  }
  Dev_Description;

  @UI.identification: [{ position: 40, label: 'Choose Excel File' }]
  Attachment;

  @UI:{ lineItem: [{ position: 55, importance: #HIGH, label: 'Template Status', criticality: 'Template_Criticality' }],
        dataPoint: { qualifier: 'templateStatus', title: 'Template Status', criticality: 'Template_Criticality' }
  }
  Templete_Status;

  @UI.lineItem: [{ position: 40, importance: #HIGH, label: 'Excel Filename' }]
  File_Name;

  @UI:{ lineItem: [{ position: 50, importance: #HIGH, label: 'File Status', criticality: 'Criticality' }],
        dataPoint: { qualifier: 'fileStatus', title: 'File Status', criticality: 'Criticality' }
  }
  File_Status;

  @UI:{ lineItem: [{ position: 60, importance: #HIGH, label: 'Last Changed At' }],
        fieldGroup: [{ qualifier: 'logs', label: 'Last Changed At', position: 20 }],
        dataPoint: { qualifier: 'fileChanged', title: 'Last Changed At' }
  }
  Local_Last_Changed_At;

  @UI:{ lineItem: [{ position: 70, importance: #HIGH, label: 'Created By' }],
        fieldGroup: [{ qualifier: 'logs', label: 'Created By', position: 10 }]
  }
  Local_Created_By;

}