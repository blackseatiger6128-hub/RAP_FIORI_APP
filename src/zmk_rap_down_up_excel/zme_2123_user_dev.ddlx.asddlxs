@Metadata.layer: #CORE
@UI.headerInfo : {
 typeName: 'Developed Object',
 typeNamePlural: 'Developed Objects',
 title: {
        type: #STANDARD,
        label: 'Development Id',
        value: 'Dev_Id' // this will display as Header title
    },
 description : { value: 'Dev_Id' } //this will be dispalyed below header title
}
annotate view ZC_2123_USER_DEV with
{
  @UI.facet: [
    {
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Developed Objects',
      position: 10
    }
  ]

  @UI.hidden: true
  @UI.identification: [{ position: 10, label: 'Employee Id' }]
  Emp_Id;

  @UI.lineItem: [{ position: 10, importance: #HIGH, label: 'Development Id' }]
  @UI.identification: [{ position: 20, label: 'Development Id' }]
  Dev_Id;

  @UI.lineItem: [{ position: 1, importance: #HIGH, label: 'Serial No' }]
  Serial_No;

  @UI.lineItem: [{ position: 20, importance: #HIGH, label: 'Object Type' }]
  @UI.identification: [{ position: 30, label: 'Object Type' }]
  Object_Type;

  @UI.lineItem: [{ position: 30, importance: #HIGH, label: 'Object Name' }]
  @UI.identification: [{ position: 40, label: 'Object Name' }]
  Object_Name;

  @UI.hidden: true
  _User;
}