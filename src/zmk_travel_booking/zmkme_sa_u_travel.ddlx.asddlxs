@Metadata.layer: #PARTNER
@UI.headerInfo: { 
  typeName: 'Travel',
  typeNamePlural: 'Travel Requests',
  title: { 
     value: 'TravelId'
  },
  description: { value: 'AgencyName' }
}

annotate entity ZMKI_SA_U_TRAVEL
    with 
{  
   @UI.facet: [
     { 
        purpose: #STANDARD,
        type: #DATAPOINT_REFERENCE,
        id: 'statusData',
        label: 'Status',
        position: 10
        
     },
     { 
        purpose: #STANDARD,
        type: #DATAPOINT_REFERENCE,
        id: 'priceData',
        label: 'Price',
        position: 20       
     },
     { 
        purpose: #STANDARD,
        type: #COLLECTION,
        id: 'collectFacet',
        label: 'More Information',
        position: 10       
     },
     { 
        purpose: #STANDARD,
        type: #IDENTIFICATION_REFERENCE,
        position: 10,   
        parentId: 'collectFacet',
        label: 'Vacation Details' 
     },
     { 
        purpose: #STANDARD,
        type: #FIELDGROUP_REFERENCE,
        position: 20,   
        parentId: 'collectFacet',
        label: 'Dates',
        targetQualifier: 'dates'
     },
     { 
        purpose: #STANDARD,
        type: #FIELDGROUP_REFERENCE,
        position: 30,   
        parentId: 'collectFacet',
        label: 'Prices',
        targetQualifier: 'prices'
     }
   ]
   @UI.selectionField: [{ position: 10 }]
   @UI.lineItem:[{ position: 10 }, { type: #FOR_ACTION, dataAction: 'set_booked_status', label: 'Set Status' }]
   @UI.identification: [ { position: 10 } ]
   TravelId;
   
   @UI.selectionField: [{ position: 20 }]
   @UI.lineItem:[{ position: 20 }]
   @UI.identification: [ { position: 20  } ]
   AgencyId;
   
   @UI.selectionField: [{ position: 30 }]
   @UI.lineItem:[{ position: 30 }]
   @UI.identification: [ { position: 30  } ]
   CustomerId;
   
   @UI.lineItem:[{ position: 40 }]
   @UI.fieldGroup: [{ position: 10, qualifier: 'dates' }]
   BeginDate;
   
   @UI.lineItem:[{ position: 50 }]
   @UI.fieldGroup: [{ position: 20, qualifier: 'dates' }]
   EndDate;
   
   @UI.lineItem:[{ position: 60 }]
   @UI.fieldGroup: [{ position: 10, qualifier: 'prices' }]
   BookingFee;
 
   @UI.selectionField: [{ position: 40 }]
   @UI.lineItem:[{ position: 70 }]
   @UI.dataPoint: { qualifier: 'priceData' }
   @UI.fieldGroup: [{ position: 20, qualifier: 'prices' }]
   TotalPrice;
   
   @UI.lineItem:[{ position: 80 }]
   @UI.fieldGroup: [{ position: 30, qualifier: 'prices' }]
   CurrencyCode;
   
   @UI.selectionField: [{ position: 50 }]
   @UI.lineItem:[{ position: 90 }]
   @UI.identification: [ { position: 40  } ]
   description;
   
   @UI.selectionField: [{ position: 60 }]
   //@UI.lineItem:[{ position: 100, importance: #HIGH, criticality: 'Criticality' }]
   //@UI.dataPoint: { criticality: 'Criticality', qualifier: 'statusData' }
   //@UI.identification: [{ position: 50, importance: #HIGH, criticality: 'Criticality' }]
   @UI.textArrangement: #TEXT_LAST // Shows "Open (O)" or "O" depending on VH setup
   //@UI.fieldGroup: [{ position: 30, qualifier: 'dates' }]
   //overallstatus;
   TravelStatus;
   
   @UI.hidden: true
   CreatedBy;
   
   @UI.hidden: true
   CreatedAt;
   
   @UI.hidden: true
   LastChangedBy;
   
   @UI.hidden: true
   LastChangedAt;
   //_Agency;
   //_Customer;
   //_Currency;
   //_OverallStatus;
   //_Booking;
   
}