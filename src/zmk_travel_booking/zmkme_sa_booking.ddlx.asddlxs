@Metadata.layer: #PARTNER
@UI.headerInfo: { 
  typeName: 'Booking',
  typeNamePlural: 'Bookings',
  title: { 
     value: 'BookingId'
  },
  description: { value: 'BookingDate' }
}
annotate entity ZMKC_SA_BOOKING
    with 
{  
    @UI.facet: [
     { 
        purpose: #STANDARD,
        type: #COLLECTION,
        id: 'bookdetail',
        label: 'Booking Details',
        position: 10       
     },
     { 
        id: 'supplementFacet',
        purpose: #STANDARD,
        type: #LINEITEM_REFERENCE,
        targetElement: '_BookingSupplement',
        position: 20,   
        label: 'Supplements'
     },
     { 
        purpose: #STANDARD,
        type: #IDENTIFICATION_REFERENCE,
        position: 10,   
        parentId: 'bookdetail',
        label: 'Booking Info',
        targetQualifier: 'bookinfo' 
     },
     { 
        purpose: #STANDARD,
        type: #FIELDGROUP_REFERENCE,
        position: 20,   
        parentId: 'bookdetail',
        label: 'Pricings',
        targetQualifier: 'priceinfo'
     }
    ]
    @UI.identification: [ { position: 10 } ]
    TravelId;
    @UI.lineItem:[{ position: 10 }]
    @UI.identification: [ { position: 20 } ]
    BookingId;
    @UI.lineItem:[{ position: 20 }]
    @UI.identification: [ { position: 30 } ]
    BookingDate;
    @UI.lineItem:[{ position: 30 }]
    @UI.fieldGroup: [{ position: 10, qualifier: 'priceinfo' }]
    CustomerId;
    @UI.lineItem:[{ position: 40 }]
    @UI.fieldGroup: [{ position: 20, qualifier: 'priceinfo' }]
    CarrierId;
    @UI.lineItem:[{ position: 50 }]
    @UI.fieldGroup: [{ position: 30, qualifier: 'priceinfo' }]
    ConnectionId;
    @UI.lineItem:[{ position: 60 }]
    @UI.fieldGroup: [{ position: 40, qualifier: 'priceinfo' }]
    FlightDate;
    @UI.lineItem:[{ position: 70 }]
    @UI.fieldGroup: [{ position: 50, qualifier: 'priceinfo' }]
    FlightPrice;
    @UI.lineItem:[{ position: 80 }]
    @UI.fieldGroup: [{ position: 60, qualifier: 'priceinfo' }]
    CurrencyCode;
    @UI.lineItem:[{ position: 90 }]
    @UI.fieldGroup: [{ position: 70, qualifier: 'priceinfo' }]
    BookingStatus;
    @UI.fieldGroup: [{ position: 80, importance: #HIGH }]
    co2tax;
    @UI.fieldGroup: [{ position: 90, importance: #HIGH }]
    dayofthelight;
  
    @UI.hidden: true
    LastChangedAt;

    
}